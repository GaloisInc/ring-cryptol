module step3 where

maj : [32] -> [32] -> [32] -> [32]
maj x y z = (x && y) || (x && z) || (y && z)

rotl: [32] -> [32] -> [32]
rotl x n = x <<< n

ch : [32] -> [32] -> [32] -> [32]
ch x y z = (x && y) || (~x && z)

parity : [32] -> [32] -> [32] -> [32]
parity x y z = x ^ y ^ z

step3_ch : ([32], [32], [32], [32], [32], [20][32]) -> ([32], [32], [32], [32], [32])
step3_ch (a, b, c, d, e, ws) = res!0
           where res = [(a, b, c, d, e)] # [ ( (r.0 <<< 5) + (ch r.1 r.2 r.3) + r.4 + 0x5a827999 + w
                       , r.0
                       , r.1 <<< 30
                       , r.2
                       , r.3) | w <- ws| r <- res ]

step3_maj : ([32], [32], [32], [32], [32], [20][32]) -> ([32], [32], [32], [32], [32])
step3_maj (a, b, c, d, e, ws) = res!0
           where res = [(a, b, c, d, e)] # [ ( (r.0 <<< 5) + (maj r.1 r.2 r.3) + r.4 + 0x8f1bbcdc + w
                       , r.0
                       , r.1 <<< 30
                       , r.2
                       , r.3) | w <- ws| r <- res ]

step3_parity1 : ([32], [32], [32], [32], [32], [20][32]) -> ([32], [32], [32], [32], [32])
step3_parity1 (a, b, c, d, e, ws) = res!0
           where res = [(a, b, c, d, e)] # [ ( (r.0 <<< 5) + (parity r.1 r.2 r.3) + r.4 + 0x6ed9eba1 + w
                       , r.0
                       , r.1 <<< 30
                       , r.2
                       , r.3) | w <- ws| r <- res ]

step3_parity2 : ([32], [32], [32], [32], [32], [20][32]) -> ([32], [32], [32], [32], [32])
step3_parity2 (a, b, c, d, e, ws) = res!0
           where res = [(a, b, c, d, e)] # [ ( (r.0 <<< 5) + (parity r.1 r.2 r.3) + r.4 + 0xca62c1d6 + w
                       , r.0
                       , r.1 <<< 30
                       , r.2
                       , r.3) | w <- ws| r <- res ]